platform :ios, '12.0'

# Use private spec repo for SparklingMethod and Sparkling
source 'https://cdn.cocoapods.org/'

use_modular_headers!

install! 'cocoapods',
:generate_multiple_pod_projects => true,
:incremental_installation => true,
:deterministic_uuids => true

inhibit_all_warnings!

SPARKLING_VERSION = '2.0.1'

def sparkling_methods
  pod 'SparklingMethod', SPARKLING_VERSION, :subspecs => [
  'Lynx', 'DIProvider', 'Debug'
  ]
end

def sparkling_methods_dep
  # BEGIN SPARKLING AUTOLINK
  pod 'Sparkling-Db', :path => '../node_modules/sparkling-db/ios'
  pod 'Sparkling-KeepAwake', :path => '../node_modules/sparkling-keep-awake/ios'
  pod 'ios', :path => '../node_modules/sparkling-media'
  pod 'Sparkling-Router', :path => '../node_modules/sparkling-navigation/ios'
  pod 'Sparkling-Storage', :path => '../node_modules/sparkling-storage/ios'
  # END SPARKLING AUTOLINK
end

# `sparkling autolink` rewrites the block above on every run. The published
# sparkling-media package has no `ios` section in its module.config.json, so
# autolink emits a pod named after the fallback directory (`ios`) pointing at
# the package root, where there is no podspec. Correct that line here instead
# of hand-editing the generated block (same approach as the
# `gradle.settingsEvaluated` override in ../android/settings.gradle.kts).
SPARKLING_AUTOLINK_FIXES = {
  '../node_modules/sparkling-media' => { :name => 'Sparkling-Media', :path => '../node_modules/sparkling-media/ios' },
}

def sparkling_methods_dep_fixed
  original = method(:pod)
  define_singleton_method(:pod) do |name, *requirements|
    options = requirements.last.is_a?(Hash) ? requirements.pop : {}
    if (fix = SPARKLING_AUTOLINK_FIXES[options[:path]])
      name = fix[:name]
      options = options.merge(:path => fix[:path])
    end
    requirements << options unless options.empty?
    original.call(name, *requirements)
  end
  sparkling_methods_dep
ensure
  singleton_class.send(:remove_method, :pod)
end

def sparkling_kit
  pod 'Sparkling', SPARKLING_VERSION
  sparkling_methods
  sparkling_methods_dep_fixed
  
  pod 'Lynx', '3.6.0', :subspecs => [
    'Framework',
    'ReleaseResource'
  ]
  
  pod 'PrimJS', '3.6.1', :subspecs => ['quickjs', 'napi']

  pod 'LynxService', '3.6.0', :subspecs => [
  'Image',
  'Log',
  'Http',
  'Devtool'
  ]

#  pod 'BaseDevtool'
  pod 'LynxDevtool', '3.6.0', :subspecs => [
   'Framework',
  ]
  
  pod 'SnapKit'
  pod 'Mantle', '~> 2.2.0'
  
  pod 'SDWebImage','5.21.7'
  pod 'SDWebImageWebPCoder', '0.15.0'
  
end

use_frameworks!
target 'SparklingGo' do
  sparkling_kit
end

target 'SparklingGoTests' do
  sparkling_kit
end

target 'SparklingMethodTests' do
  sparkling_kit
end

target 'SparklingGoUITests' do
  sparkling_kit
end
