{
  "name": "sparkling-keep-awake",
  "platforms": ["android", "ios"],
  "version": "1.0.0",
  "description": "Keep the screen on while cooking",
  "methods": {
    "setEnabled": {
      "description": "Enable or disable keeping the screen on",
      "parameters": { "enabled": "boolean" },
      "returns": { "success": "boolean" }
    }
  },
  "android": {
    "packageName": "app.imkitchen.keepawake",
    "className": "KeepAwakeSetEnabledMethod",
    "buildGradle": "android/build.gradle.kts"
  },
  "ios": {
    "moduleName": "KeepAwake",
    "className": "KeepAwakeSetEnabledMethod",
    "podspecPath": "ios/Sparkling-KeepAwake.podspec",
    "swiftVersion": "5.0"
  }
}
