{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Sparkling publishes -test.N builds to Maven Central; they are prereleases, not releases",
      "matchPackagePatterns": [
        "^com\\.tiktok\\.sparkling"
      ],
      "allowedVersions": "!/-test\\./"
    },
    {
      "description": "LynxService/Image 3.6.0 pins these two exactly; CocoaPods cannot resolve any other version until Sparkling moves off Lynx 3.6.0",
      "matchManagers": [
        "cocoapods"
      ],
      "matchPackageNames": [
        "SDWebImage",
        "SDWebImageWebPCoder"
      ],
      "enabled": false
    }
  ]
}
