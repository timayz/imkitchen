{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Sparkling publishes -test.N builds to Maven Central; they are prereleases, not releases",
      "matchPackagePatterns": [
        "^com\\.tiktok\\.sparkling"
      ],
      "allowedVersions": "!/-test\\./"
    }
  ]
}
